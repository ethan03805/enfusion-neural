  "review": [
    {
      "lead": "Custom GPU keyword matches",
      "assessment": "Both matches are unrelated: m_mLogBuffer is a map of log messages; GetPoints2D3D converts shape-spline points. No custom GPU entry point was identified by these expressions."
    },
    {
      "lead": "Material and camera postprocess",
      "assessment": "Material creation/loading and parameter methods refer to material classes; the postprocess enum names built-in effects. Reviewed signatures do not identify custom shader compilation/dispatch or scene-buffer ownership."
    },
    {
      "lead": "RTTextureWidget and RenderTargetWidget",
      "assessment": "Entity material bindings and engine-managed world/camera views are documented. Reviewed signatures do not return native texture/queue/fence handles or accept this backend output."
    },
    {
      "lead": "TextureResourceInfo and SCR_ImageHelper",
      "assessment": "Texture conversion metadata, image arrays, PNG writing, colorspace changes and raw-image callbacks are documented. These do not establish a scene-conditioned render pass."
    },
    {
      "lead": "TraceParam",
      "assessment": "Collision polygon normal/material fields are not verified rasterized shading normals, evaluated PBR values, or alpha-tested visibility. They cannot be silently substituted for model inputs."
    },
    {
      "lead": "Generate Shaders option",
      "assessment": "Official Resource Manager options list a setting by that name without a custom shader format or extension sample. A setting label is not proof of an extension interface."
    }
  ],
